    "docs:db": "node scripts/schema-doc.mjs",
    "doctor": "node scripts/doctor.mjs",
    "staff": "node scripts/staff.mjs",
    "push:keys": "node scripts/push-keys.mjs",
    "report": "node scripts/report.mjs",
    "test:sms": "tsx scripts/test-sms.mts",
    "test:personal": "tsx scripts/test-personal.ts",
    "test:account": "tsx scripts/test-account.ts",
