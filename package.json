  "dependencies": {
    "@stripe/react-stripe-js": "^6.8.2",
    "@stripe/stripe-js": "^9.14.0",
    "bcryptjs": "2.4.3",
    "better-sqlite3": "^12.11.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "^0.40.1",
    "jose": "5.9.6",
    "next": "15.3.1",
    "pdfkit": "^0.20.2",
    "react": "19.1.0",
