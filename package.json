    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.1",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "10.4.21",
    "drizzle-kit": "^0.30.5",
    "postcss": "8.5.3",
