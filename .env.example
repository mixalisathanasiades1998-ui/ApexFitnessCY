# ---------- Database ----------
# Local development (SQLite, zero setup). This file is COMMITTED, so it must
# never hold a real credential: a connection string with a live password in it
# was pushed to a public repository from here once, and the only fix for that is
# rotating the password. Real values go in .env, which is gitignored.
DATABASE_URL="file:./dev.db"

# Optional, and NOT where the website reads its data from. This is the Postgres
# database that `npm run db:mirror` copies into, so the tables can be browsed in
# Render's dashboard. Leave it empty and the mirror simply refuses to run.
#
# Two things worth knowing. It must never be swapped with DATABASE_URL above:
# that one is a FILE PATH, and handed a connection string the app does not fail,
# it silently creates an empty SQLite database in a folder named `postgresql:`
# and serves the studio from it. And the value is a live credential, so it goes
# in Render's environment panel and in .env, never in this committed file.
MIRROR_DATABASE_URL=""

# ---------- Auth ----------
# Any long random string. Generate one: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ---------- App ----------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ============================================================================
#  Payments
# ============================================================================
# Which provider takes the money. Leave it out and the app uses the first one
# that is properly configured, which is what you want in development. Name it
# explicitly on the live site: then a missing key is a loud error instead of a
# checkout that quietly falls back to test mode and gives sessions away.
#
#   stripe   card fields inside our own page
#   hosted   a bank gateway with a merchant id and an endpoint (JCC, Viva, …)
#   test     the card form that charges nothing, for development
#
# PAYMENT_PROVIDER="stripe"

# ---------- Stripe ----------
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
# From: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# ---------- The studio's invoice (VAT) ----------
# What prints on the invoice attached to every card payment's confirmation
# email. These are FACTS ABOUT A COMPANY, which is why they are configuration:
# a rate rises, an address moves, and correcting a typo on a legal document
# should not need a deploy.
#
# Until every one of them is real, the invoice is stamped SPECIMEN across the
# page and consumes no invoice number. That is deliberate, not a bug: a document
# carrying a made-up VAT number, forwarded by a member to a real accountant, is
# a false tax document with the studio's name on it. See src/lib/invoice.ts.
#
# The values below are placeholders and will be REFUSED as such. Replace all of
# them together, then check with:  npm run invoice:preview
INVOICE_LEGAL_NAME=""
INVOICE_ADDRESS="Grigori Afxentiou 9, Livadia, Larnaca 7060, Cyprus"
# CY + eight digits + one letter. Leave empty if not VAT registered.
INVOICE_VAT_NUMBER=""
INVOICE_REG_NUMBER=""
# A percentage: 19 means 19%. Ask the accountant which rate applies to
# reformer pilates classes before putting a number here.
INVOICE_VAT_RATE=""
INVOICE_EMAIL="info@ergonsite.com"
INVOICE_PHONE=""
# Optional text before the year, e.g. "AP-" gives AP-2026-0001.
INVOICE_PREFIX=""

# ---------- A bank gateway instead (JCC, Viva, Trust Payments, …) ----------
# Fill these in from the provider's integration sheet. docs/payments.md lists
# the exact questions to ask them, and what each answer maps to here.
# Nothing is guessed: until the required four are present this provider reports
# itself as unconfigured and is skipped.
#
# HOSTED_PAY_LABEL="JCC"                       # shown to the member
# HOSTED_PAY_ENDPOINT="https://.../payment"    # where the member is sent
# HOSTED_PAY_METHOD="GET"                      # GET or POST
# HOSTED_PAY_MERCHANT_ID="000000000"
# HOSTED_PAY_SECRET="the shared secret"
#
# Their parameter names, mapped to ours:
# HOSTED_PAY_FIELDS="merchant:MerchantID,order:Order,amount:Amount,currency:CurrencyCode,return:ResponseURL,cancel:BackURL,description:Description,email:Email"
# HOSTED_PAY_AMOUNT_FORMAT="decimal"           # decimal (12.34) or cents (1234)
# HOSTED_PAY_CURRENCY_CODE="EUR"               # or the ISO number, e.g. 978
#
# How they want the digest built:
# HOSTED_PAY_SIGNATURE_FIELD="Signature"
# HOSTED_PAY_SIGNATURE_ORDER="merchant,order,amount,currency"
# HOSTED_PAY_SIGNATURE_ALGO="hmac-sha256-hex"  # or hmac-sha256-base64,
#                                              # hmac-sha1-hex, sha256-hex,
#                                              # sha1-hex, md5-hex
# HOSTED_PAY_SIGNATURE_SEPARATOR=""
#
# What comes back to /api/payments/return:
# HOSTED_PAY_CALLBACK_ORDER_FIELD="Order"
# HOSTED_PAY_CALLBACK_STATUS_FIELD="ResponseCode"
# HOSTED_PAY_CALLBACK_PAID_VALUES="0,00,APPROVED"
# HOSTED_PAY_CALLBACK_REF_FIELD="TransactionId"
# HOSTED_PAY_CALLBACK_SIGNATURE_FIELD="Signature"
#
# Optional but much better: a server-to-server status check, so a payment is
# confirmed by asking the bank rather than by reading a return URL.
# HOSTED_PAY_VERIFY_URL="https://.../status"
# HOSTED_PAY_VERIFY_METHOD="GET"
# HOSTED_PAY_VERIFY_ORDER_FIELD="Order"
# HOSTED_PAY_VERIFY_STATUS_FIELD="Status"
# HOSTED_PAY_VERIFY_PAID_VALUES="PAID,APPROVED,0,00"

# ---------- The card form that charges nothing ----------
# With no provider configured, checkout shows a card form that takes no money
# and grants the sessions, so the whole journey can be walked end to end. On in
# development automatically. Set this to allow it in a production build too —
# useful for a staging demo, and to be kept off the live site.
# ALLOW_TEST_PAYMENTS="true"

# ---------------------------------------------------------------- notifications
# Push: no account needed. Run `npm run push:keys` and paste the result here.
# Regenerating these silently cuts off every device already subscribed.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@apexpilates.cy

# Email: log | resend | brevo   (see docs/notifications.md — the DNS records
# matter more than the API key)
EMAIL_PROVIDER=log
EMAIL_FROM="APEX pilates <hello@apexpilates.cy>"
RESEND_API_KEY=
BREVO_API_KEY=

# ---------------------------------------------------------------- SMS
#
# The studio's provider is SMS.to — a Cyprus company, so a euro invoice and a
# Cyprus route. Roughly EUR 0.02 a message.
#
# TO TURN SMS ON, after the client has created the SMS.to account:
#
#   1. change SMS_PROVIDER below from `log` to `smsto`
#   2. paste the API key into SMSTO_API_KEY
#   3. restart the server
#
# That is the whole switch. Until step 1 is done nothing is sent to anybody and
# nothing is charged — `log` writes each message to the server console instead,
# so the desk screen, the counts and the history all work exactly as they will
# in the end. Change it back to `log` at any time to stop dead.
#
# SMS_SENDER is the name that appears in the recipient's inbox instead of a phone
# number. It must be whitelisted with SMS.to before the first send, costs
# nothing, and is capped at 11 characters by the SMS standard.
#
# SMS_PROVIDER: log | smsto | twilio | brevo
SMS_PROVIDER=log
SMSTO_API_KEY=
SMS_SENDER=APEXPILATES
SMS_DEFAULT_COUNTRY=357

# What one message segment costs, so the desk sees money and not only a count.
# Leave it empty and the screen shows the number of messages and says nothing
# about euros — better than showing a price that is out of date.
SMS_PRICE_PER_SEGMENT=0.02

# The most messages one announcement may become per person before the desk is
# stopped. A guard against pasting a whole notice into a text, not a style rule.
SMS_MAX_SEGMENTS=4

# Only if the studio ever moves off SMS.to.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# The reminder sweep needs waking from outside. Any long random string; the
# scheduler sends it as `authorization: Bearer <this>`.
CRON_SECRET=

# Which channels the three automatic messages (booked / cancelled / reminder)
# may use. Push always. Add email freely; add sms only with the invoice in mind,
# since these fire per booking rather than per announcement.
REMINDER_CHANNELS=push
